generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String             @id @default(uuid())
  username         String             @unique
  password         String
  name             String
  role             Role               @default(STUDENT)
  avatarUrl        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  assignments      Assignment[]
  userAssignments  UserAssignment[]
  attendances      Attendance[]
  studentClasses   ClassStudent[]
  teacherClasses   ClassTeacher[]
  journals         Journal[]
  materials        Material[]
  waliClasses      Class[]            @relation("WaliKelas")
  SpiritualJournal SpiritualJournal[]
  ForumDiscussion  ForumDiscussion[]
  ForumReply       ForumReply[]
  Exam             Exam[]
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  DUDI
}

model Class {
  id              String            @id @default(uuid())
  name            String
  description     String?
  level           Int?
  waliId          String?
  wali            User?             @relation("WaliKelas", fields: [waliId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now())
  assignments     Assignment[]
  attendances     Attendance[]
  students        ClassStudent[]
  teachers        ClassTeacher[]
  journals        Journal[]
  materials       Material[]
  ForumDiscussion ForumDiscussion[]
  Exam            Exam[]
}

model Subject {
  id              String            @id @default(uuid())
  code            String?
  name            String
  description     String?
  assignments     Assignment[]
  teachers        ClassTeacher[]
  journals        Journal[]
  materials       Material[]
  ForumDiscussion ForumDiscussion[]
  Exam            Exam[]
}

model ClassStudent {
  userId    String
  classId   String
  classInfo Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, classId])
}

model ClassTeacher {
  userId    String
  classId   String
  subjectId String
  classInfo Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, classId, subjectId])
}

model Material {
  id          String   @id @default(uuid())
  title       String
  description String?
  url         String?
  authorId    String
  classId     String
  subjectId   String
  createdAt   DateTime @default(now())
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  classInfo   Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String           @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime
  authorId    String
  classId     String
  subjectId   String
  createdAt   DateTime         @default(now())
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  classInfo   Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  submissions UserAssignment[]
}

model UserAssignment {
  userId       String
  assignmentId String
  score        Float?
  submittedAt  DateTime?
  status       String     @default("PENDING")
  description  String?
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, assignmentId])
}

model Attendance {
  id           String    @id @default(uuid())
  userId       String
  classId      String?
  date         DateTime  @default(now())
  status       String
  lat          Float?
  lng          Float?
  createdAt    DateTime  @default(now())
  checkOutTime DateTime?
  classInfo    Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Journal {
  id        String   @id @default(uuid())
  title     String
  content   String
  authorId  String
  classId   String
  subjectId String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  classInfo Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model Violation {
  id          String   @id @default(uuid())
  studentId   String
  reporterId  String
  description String
  points      Int
  createdAt   DateTime @default(now())
}

model AppSetting {
  key   String @id
  value String
}

model Broadcast {
  id        String   @id @default(uuid())
  title     String
  message   String
  target    String
  createdAt DateTime @default(now())
}

model SpiritualJournal {
  id        String   @id @default(uuid())
  userId    String
  activity  String
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LibraryBook {
  id          String   @id @default(uuid())
  title       String
  author      String
  category    String
  pages       String?
  coverColor  String?
  description String?
  fileUrl     String?
  downloads   Int      @default(0)
  createdAt   DateTime @default(now())
}

model ForumDiscussion {
  id        String       @id @default(uuid())
  title     String
  content   String
  authorId  String
  classId   String?
  subjectId String?
  createdAt DateTime     @default(now())
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  classInfo Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  subject   Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  replies   ForumReply[]
}

model ForumReply {
  id           String          @id @default(uuid())
  discussionId String
  authorId     String
  content      String
  createdAt    DateTime        @default(now())
  discussion   ForumDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  day       String
  name      String
  startTime String
  endTime   String
  type      String   @default("Reguler")
  createdAt DateTime @default(now())
}

model Exam {
  id          String           @id @default(uuid())
  title       String
  type        String           @default("PG")
  classId     String
  subjectId   String
  authorId    String
  duration    Int              @default(60)
  createdAt   DateTime         @default(now())
  questions   ExamQuestion[]
  submissions ExamSubmission[]
  classInfo   Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model ExamQuestion {
  id            String  @id @default(uuid())
  examId        String
  question      String
  imageUrl      String?
  type          String  @default("PG")
  options       String?
  correctAnswer String?
  points        Int     @default(10)
  exam          Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model ExamSubmission {
  id          String   @id @default(uuid())
  examId      String
  userId      String
  answers     String?
  score       Float?
  submittedAt DateTime @default(now())
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model Schedule {
  id           String   @id @default(uuid())
  day          String
  sessionStart String
  sessionEnd   String
  classId      String
  subjectId    String?
  teacherId    String?
  room         String?
  type         String   @default("REGULAR")
  label        String?
  createdAt    DateTime @default(now())
}
