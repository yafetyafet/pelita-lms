# Caddy untuk PELITA LMS
# Pasang di: /etc/caddy/Caddyfile  lalu  sudo systemctl reload caddy
#
# GANTI `lms.sekolah.sch.id` dengan domain sekolah yang sebenarnya.
# Let's Encrypt butuh NAMA DOMAIN - tidak bisa IP telanjang - dan port 80/443
# harus terjangkau dari internet untuk verifikasinya.
#
# HTTPS bukan pilihan: peramban MEMBLOKIR akses lokasi di situs non-HTTPS,
# sehingga presensi GPS siswa tidak akan berfungsi tanpa ini.

lms.sekolah.sch.id {
	# WAJIB. Vercel mengompresi otomatis, server sendiri tidak.
	# Tanpa baris ini siswa mengunduh 469 KB, bukan 140 KB.
	encode zstd gzip

	# Berkas statis Next.js bertanda immutable: aman di-cache selamanya
	# karena nama berkasnya berubah setiap kali isinya berubah.
	@statis path /_next/static/* /icon-192.png /icon-512.png /logo-pelita*.png
	header @statis Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy 127.0.0.1:3000

	log {
		output file /var/log/caddy/pelita.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
